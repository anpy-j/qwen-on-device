<?xml version="1.0" encoding="utf-8"?>
<!-- Hero 深色玻璃卡片：135° 深蓝渐变 + 1px 细白描边 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/corner_card_lg" />
    <gradient
        android:angle="135"
        android:startColor="@color/hero_surface_top"
        android:centerColor="@color/hero_surface_center"
        android:endColor="@color/hero_surface_bottom" />
    <stroke android:width="1dp" android:color="#29FFFFFF" />
</shape>
