<?xml version="1.0" encoding="utf-8"?>
<!--
  QwenOnDevice 设计令牌（浅色基线）。
  色板来源：design-system/qwenondevice/MASTER.md（Personal Finance Tracker · Glassmorphism）
  信任蓝 #1E40AF + 收益绿 #059669；深色 Hero 卡片在深浅模式下保持一致。
-->
<resources>
    <!-- ===== 品牌主色（信任蓝，深浅色通用） ===== -->
    <color name="primary">#1E40AF</color>
    <color name="primary_gradient_start">#1E40AF</color>
    <color name="primary_gradient_end">#1D4ED8</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#DBEAFE</color>
    <color name="on_primary_container">#1E3A8A</color>

    <color name="secondary">#3B82F6</color>
    <color name="secondary_gradient_start">#3B82F6</color>
    <color name="secondary_gradient_end">#2563EB</color>
    <color name="on_secondary">#FFFFFF</color>

    <!-- ===== 强调 / CTA（收益绿）与破坏色 ===== -->
    <color name="accent">#059669</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="destructive">#DC2626</color>
    <color name="on_destructive">#FFFFFF</color>

    <!-- ===== 深色 Hero 卡片（顶栏 + 资产看板，深浅色通用） ===== -->
    <color name="hero_surface_top">#1E293B</color>
