    <!-- ===== 浅色语义角色色（深色在 values-night 覆盖） ===== -->
    <color name="background">#F5F7FB</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#EDF1F7</color>
    <color name="on_surface">#0F172A</color>
    <color name="on_surface_variant">#475569</color>
    <color name="on_surface_faint">#94A3B8</color>
    <color name="outline">#E2E8F0</color>
