    <color name="card_stroke">#E6EAF2</color>
    <color name="chip_bg">#EDF1F7</color>
    <color name="input_bg">#FFFFFF</color>
    <color name="input_stroke">#E2E8F0</color>
    <color name="chip_stroke">#DDE3EE</color>
    <color name="icon_muted">#475569</color>
    <color name="status_dot">#10B981</color>

    <!-- 数据角色色：支出 / 收入 / 结余 -->
    <color name="stat_negative">#E11D48</color>
    <color name="stat_positive">#059669</color>
    <color name="stat_neutral">#1E40AF</color>

